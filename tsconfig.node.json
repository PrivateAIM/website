{
    "extends": "@tada5hi/tsconfig",
    "include": [
        "vite.config.*",
        "scripts/**/*.ts",
        "src/utils/thumbnail.ts",
        "vitest.config.*",
        "cypress.config.*",
        "nightwatch.conf.*",
        "playwright.config.*",
        "eslint.config.*"
    ],
    "compilerOptions": {
        "noEmit": false,
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rewriteRelativeImportExtensions": true,
        "types": ["node"]
    }
}
